<!DOCTYPE html>
<%/*
  Shell of the utility pages, in the identity of the new landing (green band with the
  lockup, paper, rules, Archivo, same footer). Styles: src/styles/utility.css.

  Two modes:
  - it.runtime = true  → one URL, language picked in the browser (404, /join/,
    /reset-password/). All 5 string sets are inlined; the server-rendered text is the
    default locale (no-JS fallback) and every translatable node carries data-t.
  - it.runtime = false → one page per language (/delete-account/, /es/delete-account/…);
    the language menu links to the other versions.
  Every URL here must be absolute: 404.html is served at arbitrary nested paths.
*/%>
<%
  const e = it.esc;
  const b = it.brand;
  const current = it.langs.find((l) => l.code === it.locale);
%>
<html lang="<%= it.locale %>">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
  <meta name="color-scheme" content="light">
  <meta name="theme-color" content="#184838">
  <meta name="robots" content="<%= it.robots %>">
<% if (it.referrer) { %>
  <meta name="referrer" content="<%= it.referrer %>">
<% } %>
<% if (it.runtime) { %>
  <title data-t="<%= it.titleKey %>"><%= e(it.s[it.titleKey]) %></title>
<% } else { %>
  <title><%= e(it.pageTitle) %></title>
<% } %>
<% if (it.description) { %>
  <meta name="description" content="<%= e(it.description) %>">
<% } %>
<% if (it.canonicalUrl) { %>
  <link rel="canonical" href="<%= it.canonicalUrl %>">
<% } %>
<% for (const [lang, href] of Object.entries(it.alternatesAbs || {})) { %>
  <link rel="alternate" hreflang="<%= lang %>" href="<%= href %>">
<% } %>
<% if (it.alternatesAbs && it.alternatesAbs[it.defaultLocale]) { %>
  <link rel="alternate" hreflang="x-default" href="<%= it.alternatesAbs[it.defaultLocale] %>">
<% } %>
<% if (it.og) { %>

  <!-- Link preview (WhatsApp, iMessage…): static, crawlers do not run scripts -->
  <meta property="og:title" content="<%= e(it.og.title) %>">
  <meta property="og:description" content="<%= e(it.og.description) %>">
  <meta property="og:image" content="<%= it.og.image %>">
  <meta property="og:image:width" content="1200">
  <meta property="og:image:height" content="630">
<% if (it.og.imageAlt) { %>
  <meta property="og:image:alt" content="<%= e(it.og.imageAlt) %>">
<% } %>
  <meta property="og:type" content="website">
<% if (it.og.url) { %>
  <meta property="og:url" content="<%= it.og.url %>">
<% } %>
<% for (const loc of (it.og.locales || [])) { %>
  <meta property="<%= loc === it.og.locales[0] ? 'og:locale' : 'og:locale:alternate' %>" content="<%= loc %>">
<% } %>
  <meta property="og:site_name" content="HomePot">
  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:title" content="<%= e(it.og.title) %>">
  <meta name="twitter:description" content="<%= e(it.og.description) %>">
  <meta name="twitter:image" content="<%= it.og.image %>">
<% } %>

  <link rel="icon" href="/assets/brand/favicon.svg" type="image/svg+xml">
  <link rel="preload" href="/assets/fonts/Archivo-VF-latin.woff2" as="font" type="font/woff2" crossorigin>
  <link rel="stylesheet" href="<%= it.cssHref %>">
<% if (it.runtime) { %>

  <script>window.__HP_I18N = <%~ it.i18nJson %>;<% if (it.headInline) { %> <%~ it.headInline %><% } %></script>
<% for (const src of (it.headScripts || [])) { %>
  <script src="<%= src %>"></script>
<% } %>
  <script src="/src/js/utility-i18n.js"></script>
<% } %>
<% if (it.jsonLd) { %>
  <script type="application/ld+json"><%~ it.jsonLdJson %></script>
<% } %>
</head>
<body>

<header class="band">
  <a class="brand" href="<%= it.homeHref %>"<% if (it.runtime) { %> data-lhref="/"<% } %>><img src="/assets/brand/logo-horizontal-white.svg" alt="HomePot" width="485" height="100"></a>
  <details class="lang">
    <summary aria-label="<%= e(b.language) %>: <%= e(current.name) %>"<% if (it.runtime) { %> data-lang-summary<% } %>><span<% if (it.runtime) { %> data-lang-code<% } %>><%= it.locale.toUpperCase() %></span> <svg viewBox="0 0 12 8" aria-hidden="true"><path d="M0 0h12L6 8z" fill="currentColor"/></svg></summary>
    <ul class="lang-menu">
<% for (const lang of it.langs) { %>
<% if (it.runtime) { %>
      <li><button type="button" data-set-lang="<%= lang.code %>" data-lang-name="<%= e(lang.name) %>" lang="<%= lang.code %>" aria-pressed="<%= lang.code === it.locale ? 'true' : 'false' %>"><%= e(lang.name) %></button></li>
<% } else { %>
      <li><a href="<%= lang.href %>" hreflang="<%= lang.code %>" lang="<%= lang.code %>"<%= lang.code === it.locale ? ' aria-current="page"' : '' %>><%= e(lang.name) %></a></li>
<% } %>
<% } %>
    </ul>
  </details>
</header>

<main class="page" id="content">
<%~ it.body %>
</main>

<footer class="foot">
  <span class="foot-brand"><img src="/assets/brand/logo-horizontal-green.svg" alt="HomePot" width="485" height="100"> <span<% if (it.runtime) { %> data-t="common.tagline"<% } %>><%= e(b.tagline) %></span></span>
  <nav aria-label="<%= e(b.legal) %>"<% if (it.runtime) { %> data-t-aria-label="common.legal"<% } %>><a href="/privacy/"<% if (it.runtime) { %> data-t="common.privacy"<% } %>><%= e(b.privacy) %></a><a href="/terms/"<% if (it.runtime) { %> data-t="common.terms"<% } %>><%= e(b.terms) %></a><a href="/support/"<% if (it.runtime) { %> data-t="common.help"<% } %>><%= e(b.help) %></a><a href="<%= it.deleteHref %>"<% if (it.runtime) { %> data-lhref="/delete-account/" data-t="common.delete_account"<% } %>><%= e(b.delete_account) %></a></nav>
</footer>

<% if (it.runtime) { %>
<script>HP.mount();</script>
<% } %>
<script src="/src/js/lang-menu.js" defer></script>
<% for (const src of (it.bodyScripts || [])) { %>
<script src="<%= src %>" defer></script>
<% } %>
<%~ it.analytics || '' %>

</body>
</html>
