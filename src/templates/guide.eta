<%/* A guide: an article in sections, then its questions. */%>
<% const p = it.page.guide; %>
  <div class="page-head">
    <h1><%= p.h1 %></h1>
    <p class="lead"><%= p.intro %></p>
    <p class="fine"><%= [p.read_time, p.updated].filter(Boolean).join(' · ') %></p>
  </div>

  <article class="page-body">
<% p.sections.forEach((section, idx) => { %>
    <section class="block"<%= section.h2 ? ` aria-labelledby="g-${idx}"` : '' %>>
<% if (section.h2) { %>
      <h2 id="g-<%= idx %>"><%= section.h2 %></h2>
<% } %>
<% for (const para of section.paragraphs) { %>
      <p class="text"><%~ para %></p>
<% } %>
<% if (section.list) { %>
      <ul class="list">
<% for (const li of section.list) { %>
        <li><%~ li %></li>
<% } %>
      </ul>
<% } %>
<% if (section.note) { %>
      <p class="keep"><%~ section.note %></p>
<% } %>
    </section>
<% }) %>
<% if (p.faq && p.faq.length) { %>

    <section class="block" aria-labelledby="g-faq">
      <h2 id="g-faq"><%= p.faq_title %></h2>
<%~ include('partials/qa', { ...it, qa: p.faq }) %>
    </section>
<% } %>

    <div class="block">
      <p class="text back"><% for (const link of it.back) { %><a href="<%= link.href %>"><%= link.label %></a><% } %></p>
    </div>
<%~ include('partials/slip', it) %>
  </article>
