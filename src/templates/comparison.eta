<%/* HomePot compared with another app: a ruled table, what is different, what the other does better, questions. */%>
<%
  const c = it.page.comparison; const entry = it.entry;
  /* true is a drawn tick (the key above the table says «a checkmark means…»), false is the word «No» */
  const value = (v) => v === true ? `${it.icons.check.replace('<svg', '<svg class="tick"')}<span class="sr">${it.ui.yes}</span>` : v === false ? it.ui.no : v;
%>
  <div class="page-head">
    <h1><%= c.h1 %></h1>
    <p class="lead"><%= c.intro %></p>
    <div class="head-actions">
      <a class="action" href="<%= it.appStore('vs-' + entry.i18nKey) %>" rel="noopener"><%~ it.icons.apple %><%= it.store.appstore %></a>
    </div>
  </div>

  <article class="page-body">
    <section class="block" aria-labelledby="cmp-table">
      <h2 id="cmp-table"><%= c.table_title %></h2>
      <p class="text"><%= c.table_subtitle %></p>
      <div class="table-wrap">
        <table class="compare">
          <thead><tr><th scope="col"><%= c.table_header_feature %></th><th scope="col">HomePot</th><th scope="col"><%= entry.competitor %></th></tr></thead>
          <tbody>
<% for (const row of c.features) { %>
            <tr><th scope="row"><%= row.label %></th><td class="yes" data-label="HomePot"><%~ value(row.ours) %></td><td data-label="<%= entry.competitor %>"><%~ value(row.theirs) %></td></tr>
<% } %>
          </tbody>
        </table>
      </div>
      <p class="fine"><%= c.table_disclaimer %></p>
    </section>

    <section class="block" aria-labelledby="cmp-diff">
      <h2 id="cmp-diff"><%= c.diff_title %></h2>
      <p class="text"><%= c.diff_subtitle %></p>
      <dl class="points">
<% for (const d of c.differentiators) { %>
        <div><dt><%= d.title %></dt><dd><%= d.desc %></dd></div>
<% } %>
      </dl>
    </section>
<% if (c.honest_note) { %>

    <section class="statement" aria-labelledby="cmp-honest">
      <h2 id="cmp-honest"><%= c.honest_note.title %></h2>
      <p class="text"><%= c.honest_note.body %></p>
    </section>
<% } %>
<% if (c.reviews && c.reviews.length) { %>

    <section class="block" aria-labelledby="cmp-reviews">
      <h2 id="cmp-reviews"><%= c.reviews_title %></h2>
      <p class="text"><%= c.reviews_subtitle %></p>
      <div class="quotes">
<% for (const r of c.reviews) { %>
        <figure class="quote">
          <blockquote>“<%= r.quote %>”</blockquote>
          <figcaption><span class="stars" role="img" aria-label="<%= r.rating || 1 %> / 5"><% for (let s = 1; s <= 5; s++) { %><%~ it.icons.star.replace('<svg', s <= (r.rating || 1) ? '<svg class="on"' : '<svg') %><% } %></span><span><%= r.author %><%= r.date ? ' · ' + r.date : '' %></span></figcaption>
        </figure>
<% } %>
      </div>
      <p class="fine"><%= [c.reviews_meta, c.reviews_disclaimer].filter(Boolean).join(' ') %></p>
    </section>
<% } %>

    <section class="block" aria-labelledby="cmp-faq">
      <h2 id="cmp-faq"><%= c.faq_title %></h2>
<%~ include('partials/qa', { ...it, qa: c.faq }) %>
    </section>

    <div class="block">
      <p class="text back"><% for (const link of it.back) { %><a href="<%= link.href %>"><%= link.label %></a><% } %></p>
    </div>
<%~ include('partials/slip', it) %>
  </article>
