<% const s = it.s; const e = it.esc; %>
  <div class="page-head">
    <h1 data-t="nf.h1"><%= e(s['nf.h1']) %></h1>
    <p class="lead" data-t="nf.body"><%= e(s['nf.body']) %></p>
  </div>
  <div class="page-body">
    <div class="block">
      <p class="figure" aria-hidden="true">404</p>
      <div class="actions">
        <a class="btn btn-solid" href="/" data-lhref="/" data-t="nf.home"><%= e(s['nf.home']) %></a>
        <a class="btn btn-line" href="/support/" data-t="common.help"><%= e(s['common.help']) %></a>
      </div>
    </div>
  </div>
