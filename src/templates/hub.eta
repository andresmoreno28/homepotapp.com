<%/* A hub: a ruled list of links to its pages (compare, guides, resources). */%>
<% const h = it.hub; %>
  <div class="page-head">
    <h1><%= h.h1 %></h1>
    <p class="lead"><%= h.intro %></p>
  </div>

  <div class="page-body">
    <ul class="links">
<% for (const item of it.items) { %>
      <li><a href="<%= item.href %>">
        <span class="links-title"><%= item.title %></span>
        <span class="links-text"><%= item.excerpt %></span>
        <span class="links-more"><%= item.cta || h.cta %></span>
      </a></li>
<% } %>
    </ul>
<% if (h.trust_title) { %>
    <section class="block" aria-labelledby="hub-note">
      <h2 id="hub-note"><%= h.trust_title %></h2>
      <p class="text"><%= h.trust_desc %></p>
<% if (h.trust_1) { %>
      <p class="fine"><%= [h.trust_1, h.trust_2, h.trust_3].filter(Boolean).join(' · ') %></p>
<% } %>
    </section>
<% } %>
<% if (it.back && it.back.length) { %>
    <div class="block">
      <p class="text back"><% for (const link of it.back) { %><a href="<%= link.href %>"><%= link.label %></a><% } %></p>
    </div>
<% } %>
<%~ include('partials/slip', it) %>
  </div>
