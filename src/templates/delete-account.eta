<%
  const p = it.page.deleteAccount;
  const emailLink = `<a href="mailto:${it.contactEmail}">${it.contactEmail}</a>`;
  const mailto = `mailto:${it.contactEmail}?subject=${encodeURIComponent(p.email_subject)}`;
  const fill = (str) => str.replace('{email}', emailLink).replace('{subject}', p.email_subject);
  const privacyLink = `<a href="/privacy/">${p.privacy_link}</a>`;
%>
  <div class="page-head">
    <h1><%= p.h1 %></h1>
    <p class="lead"><%= p.intro %></p>
    <dl class="meta">
      <dt><%= p.app_label %></dt><dd>HomePot</dd>
      <dt><%= p.developer_label %></dt><dd><%= it.developerName %></dd>
    </dl>
    <p class="fine"><%= p.updated %></p>
  </div>

  <article class="page-body">
    <!-- In-app deletion -->
    <section class="block" aria-labelledby="da-steps">
      <h2 id="da-steps"><%= p.steps_title %></h2>
      <p class="text"><%= p.steps_intro %></p>
      <ol class="steps">
<% p.steps.forEach((step) => { %>
        <li><span><%~ step %></span></li>
<% }) %>
      </ol>
      <p class="keep"><%= p.steps_note %></p>
    </section>

    <!-- What gets deleted -->
    <section class="block" aria-labelledby="da-deleted">
      <h2 id="da-deleted"><%= p.deleted_title %></h2>
      <ul class="list">
<% p.deleted_list.forEach((li) => { %>
        <li><%~ li %></li>
<% }) %>
      </ul>
    </section>

    <!-- Shared groups -->
    <section class="block" aria-labelledby="da-shared">
      <h2 id="da-shared"><%= p.shared_title %></h2>
<% p.shared_paragraphs.forEach((para) => { %>
      <p class="text"><%~ para %></p>
<% }) %>
    </section>

    <!-- Subscriptions: the one thing people get wrong, so it is set apart as a framed statement -->
    <section class="statement" aria-labelledby="da-subscription">
      <h2 id="da-subscription"><%= p.subscription_title %></h2>
      <p class="text"><%= p.subscription_intro %></p>
      <ul class="list">
<% p.subscription_list.forEach((li) => { %>
        <li><%~ li %></li>
<% }) %>
      </ul>
    </section>

    <!-- By email -->
    <section class="block" aria-labelledby="da-email">
      <h2 id="da-email"><%= p.email_title %></h2>
<% p.email_paragraphs.forEach((para) => { %>
      <p class="text"><%~ fill(para) %></p>
<% }) %>
      <table class="ledger">
        <tbody>
          <tr><th scope="row"><%= p.email_to_label %></th><td><%= it.contactEmail %></td></tr>
          <tr><th scope="row"><%= p.email_subject_label %></th><td><%= p.email_subject %></td></tr>
        </tbody>
      </table>
      <div class="actions">
        <a class="btn btn-solid" href="<%= mailto %>"><%= p.email_button %></a>
      </div>
    </section>

    <!-- Good to know -->
    <section class="block" aria-labelledby="da-notes">
      <h2 id="da-notes"><%= p.notes_title %></h2>
      <ul class="list">
<% p.notes_list.forEach((li) => { %>
        <li><%~ li %></li>
<% }) %>
      </ul>
      <p class="text"><%~ p.privacy_note.replace('{link}', privacyLink) %></p>
    </section>
  </article>
