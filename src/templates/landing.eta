<%/* /from-splitwise/: the page for people leaving Splitwise. */%>
<% const p = it.page.landing; %>
  <div class="page-head">
    <h1><%= p.h1 %></h1>
    <p class="lead"><%= p.intro %></p>
    <div class="head-actions">
      <a class="action" href="<%= it.appStore('from-splitwise') %>" rel="noopener"><%~ it.icons.apple %><%= it.store.appstore %></a>
      <a class="btn btn-line" href="<%= it.prefix %>/compare/homepot-vs-splitwise/"><%= p.cta_compare %></a>
    </div>
  </div>

  <article class="page-body">
    <section class="block" aria-labelledby="fs-props">
      <h2 id="fs-props"><%= p.props_title %></h2>
      <p class="text"><%= p.props_subtitle %></p>
      <dl class="points">
<% for (const prop of p.props) { %>
        <div><dt><%= prop.title %></dt><dd><%= prop.desc %></dd></div>
<% } %>
      </dl>
    </section>
<% if (p.honest_note) { %>

    <section class="statement" aria-labelledby="fs-honest">
      <h2 id="fs-honest"><%= p.honest_note.title %></h2>
      <p class="text"><%= p.honest_note.body %></p>
    </section>
<% } %>

    <section class="block" aria-labelledby="fs-faq">
      <h2 id="fs-faq"><%= p.faq_title %></h2>
<%~ include('partials/qa', { ...it, qa: p.faq }) %>
    </section>
<%~ include('partials/slip', it) %>
  </article>
