<%/* <head> of the pages that exist once per language (home and content pages). */%>
<% const e = it.esc; %>
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
  <meta name="color-scheme" content="light">
  <meta name="theme-color" content="#184838">
  <title><%= e(it.pageTitle) %></title>
  <meta name="description" content="<%= e(it.pageDescription) %>">
  <meta name="robots" content="index, follow">
  <link rel="canonical" href="<%= it.canonicalUrl %>">
<% for (const [lang, href] of Object.entries(it.alternatesAbs || {})) { %>
  <link rel="alternate" hreflang="<%= lang %>" href="<%= href %>">
<% } %>
<% if (it.alternatesAbs && it.alternatesAbs[it.defaultLocale]) { %>
  <link rel="alternate" hreflang="x-default" href="<%= it.alternatesAbs[it.defaultLocale] %>">
<% } %>

  <meta property="og:title" content="<%= e(it.ogTitle || it.pageTitle) %>">
  <meta property="og:description" content="<%= e(it.ogDescription || it.pageDescription) %>">
  <meta property="og:image" content="<%= it.ogImage %>">
  <meta property="og:image:width" content="1200">
  <meta property="og:image:height" content="630">
  <meta property="og:type" content="<%= it.ogType || 'website' %>">
  <meta property="og:url" content="<%= it.canonicalUrl %>">
  <meta property="og:locale" content="<%= it.ogLocale %>">
<% for (const loc of (it.ogLocaleAlternates || [])) { %>
  <meta property="og:locale:alternate" content="<%= loc %>">
<% } %>
  <meta property="og:site_name" content="HomePot">
  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:title" content="<%= e(it.ogTitle || it.pageTitle) %>">
  <meta name="twitter:description" content="<%= e(it.ogDescription || it.pageDescription) %>">
  <meta name="twitter:image" content="<%= it.ogImage %>">

  <link rel="icon" href="/assets/brand/favicon.svg" type="image/svg+xml">
  <link rel="preload" href="/assets/fonts/Archivo-VF-latin.woff2" as="font" type="font/woff2" crossorigin>
  <link rel="stylesheet" href="<%= it.cssHref %>">
<% if (it.jsonLd) { %>
  <script type="application/ld+json"><%~ it.jsonLdJson %></script>
<% } %>
</head>
