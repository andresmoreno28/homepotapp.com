<% const s = it.s; const e = it.esc; %>
    <script>window.__HP_SUPABASE = <%~ it.supabaseJson %>;</script>

    <div class="bg-white rounded-3xl shadow-sm p-6 sm:p-8">
      <div class="w-14 h-14 rounded-2xl bg-terracotta/10 text-terracotta flex items-center justify-center mb-5">
        <span class="material-symbols-outlined text-3xl" aria-hidden="true">lock_reset</span>
      </div>
      <h1 class="text-2xl sm:text-3xl font-extrabold text-darkBlue leading-tight mb-4" data-t="rp.h1"><%= e(s['rp.h1']) %></h1>

      <!-- Checking the link -->
      <div data-view="loading" class="flex items-center gap-3 text-gray-500 py-2" role="status" aria-live="polite">
        <span class="hp-spinner" aria-hidden="true"></span>
        <span data-t="rp.checking"><%= e(s['rp.checking']) %></span>
      </div>

      <!-- Invalid / expired link, network or load problems -->
      <div data-view="invalid" hidden>
        <div class="bg-terracotta/5 border border-terracotta/20 rounded-2xl p-5 mb-6" role="alert">
          <h2 class="font-bold text-darkBlue mb-2 flex items-start gap-2">
            <span class="material-symbols-outlined text-terracotta" aria-hidden="true">link_off</span>
            <span id="rp-problem-title" data-t="rp.invalid_title"><%= e(s['rp.invalid_title']) %></span>
          </h2>
          <p id="rp-problem-body" class="text-sm text-gray-600 leading-relaxed" data-t="rp.invalid_body"><%= e(s['rp.invalid_body']) %></p>
        </div>
        <a href="<%= it.appScheme %>" class="flex items-center justify-center gap-2 w-full bg-white text-darkBlue rounded-full py-3.5 px-6 font-semibold ring-1 ring-gray-200 hover:ring-terracotta transition-colors">
          <span class="material-symbols-outlined text-xl" aria-hidden="true">open_in_new</span>
          <span data-t="rp.open_app"><%= e(s['rp.open_app']) %></span>
        </a>
      </div>

      <!-- New password form -->
      <form data-view="form" id="rp-form" novalidate hidden>
        <p class="text-gray-500 mb-6" data-t="rp.intro"><%= e(s['rp.intro']) %></p>
        <!-- Lets password managers store the new password under the right account -->
        <input id="rp-username" name="username" type="email" autocomplete="username" readonly tabindex="-1" aria-hidden="true" class="sr-only">

        <div class="mb-4">
          <label for="rp-password" class="block text-sm font-semibold text-darkBlue mb-2" data-t="rp.new_password"><%= e(s['rp.new_password']) %></label>
          <div class="relative">
            <input id="rp-password" name="password" type="password" autocomplete="new-password" autocapitalize="off" autocorrect="off" spellcheck="false" required aria-describedby="rp-rules" class="w-full rounded-2xl bg-white py-3.5 pl-4 pr-12 text-darkBlue outline-none ring-1 ring-gray-200 focus:ring-2 focus:ring-terracotta transition-shadow">
            <button type="button" data-toggle-password="rp-password" aria-pressed="false" aria-label="<%= e(s['rp.show_password']) %>" data-t-aria-label="rp.show_password" class="absolute inset-y-0 right-0 flex items-center px-3 text-gray-400 hover:text-darkBlue rounded-r-2xl">
              <span class="material-symbols-outlined" aria-hidden="true">visibility</span>
            </button>
          </div>
        </div>

        <div class="mb-5">
          <label for="rp-confirm" class="block text-sm font-semibold text-darkBlue mb-2" data-t="rp.confirm_password"><%= e(s['rp.confirm_password']) %></label>
          <div class="relative">
            <input id="rp-confirm" name="confirm" type="password" autocomplete="new-password" autocapitalize="off" autocorrect="off" spellcheck="false" required class="w-full rounded-2xl bg-white py-3.5 pl-4 pr-12 text-darkBlue outline-none ring-1 ring-gray-200 focus:ring-2 focus:ring-terracotta transition-shadow">
            <button type="button" data-toggle-password="rp-confirm" aria-pressed="false" aria-label="<%= e(s['rp.show_password']) %>" data-t-aria-label="rp.show_password" class="absolute inset-y-0 right-0 flex items-center px-3 text-gray-400 hover:text-darkBlue rounded-r-2xl">
              <span class="material-symbols-outlined" aria-hidden="true">visibility</span>
            </button>
          </div>
        </div>

        <div id="rp-rules" class="bg-cream/60 rounded-2xl p-4 mb-5">
          <p class="text-sm font-semibold text-darkBlue mb-2" data-t="rp.rules_title"><%= e(s['rp.rules_title']) %></p>
          <ul class="space-y-1.5 text-sm">
<% for (const rule of ['length', 'lower', 'upper', 'digit', 'symbol', 'match']) { %>
            <li class="hp-rule flex items-center gap-2" data-rule="<%= rule %>" data-ok="false">
              <span class="hp-rule-icon material-symbols-outlined text-lg" aria-hidden="true">radio_button_unchecked</span>
              <span data-t="rp.rule_<%= rule %>"><%= e(s['rp.rule_' + rule]) %></span>
              <span class="sr-only" data-rule-state></span>
            </li>
<% } %>
          </ul>
        </div>

        <p id="rp-error" class="text-sm text-red-600 font-medium mb-4" role="alert" hidden></p>

        <button type="submit" id="rp-submit" class="w-full bg-terracotta text-white rounded-full py-4 px-6 font-semibold hover:bg-terracotta/90 disabled:opacity-60 disabled:cursor-not-allowed transition-colors">
          <span id="rp-submit-label" data-t="rp.submit"><%= e(s['rp.submit']) %></span>
        </button>
      </form>

      <!-- Done -->
      <div data-view="success" hidden>
        <div class="bg-sage/10 border border-sage/20 rounded-2xl p-5 mb-6" role="status">
          <h2 id="rp-success-title" class="font-bold text-darkBlue mb-2 flex items-start gap-2" tabindex="-1">
            <span class="material-symbols-outlined text-sage" aria-hidden="true">check_circle</span>
            <span data-t="rp.success_title"><%= e(s['rp.success_title']) %></span>
          </h2>
          <p class="text-sm text-gray-600 leading-relaxed" data-t="rp.success_body"><%= e(s['rp.success_body']) %></p>
        </div>
        <a href="<%= it.appScheme %>" class="flex items-center justify-center gap-2 w-full bg-terracotta text-white rounded-full py-4 px-6 font-semibold hover:bg-terracotta/90 transition-colors">
          <span class="material-symbols-outlined text-xl" aria-hidden="true">open_in_new</span>
          <span data-t="rp.open_app"><%= e(s['rp.open_app']) %></span>
        </a>
        <p class="text-sm text-gray-500 text-center mt-4" data-t="rp.success_hint"><%= e(s['rp.success_hint']) %></p>
      </div>
    </div>

    <noscript>
      <p class="text-sm text-gray-500 text-center mt-4">JavaScript is required to reset your password.</p>
    </noscript>
