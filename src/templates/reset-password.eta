<% const s = it.s; const e = it.esc; const i = it.icons; %>
  <script>window.__HP_SUPABASE = <%~ it.supabaseJson %>;</script>

  <div class="page-head">
    <h1 data-t="rp.h1"><%= e(s['rp.h1']) %></h1>
  </div>

  <div class="page-body one">
    <!-- Checking the link -->
    <div data-view="loading" class="block" role="status" aria-live="polite">
      <p class="status"><span class="hp-spinner" aria-hidden="true"></span><span data-t="rp.checking"><%= e(s['rp.checking']) %></span></p>
    </div>

    <!-- Invalid / expired link, network or load problems -->
    <div data-view="invalid" class="block" hidden>
      <div class="notice flat" role="alert">
        <%~ i.alert %>
        <h2 class="notice-title" id="rp-problem-title" data-t="rp.invalid_title"><%= e(s['rp.invalid_title']) %></h2>
        <p class="notice-text" id="rp-problem-body" data-t="rp.invalid_body"><%= e(s['rp.invalid_body']) %></p>
      </div>
      <div class="actions">
        <a class="btn btn-line" href="<%= it.appScheme %>" data-t="rp.open_app"><%= e(s['rp.open_app']) %></a>
      </div>
    </div>

    <!-- New password form -->
    <form data-view="form" id="rp-form" class="block" novalidate hidden>
      <p class="lead" data-t="rp.intro"><%= e(s['rp.intro']) %></p>
      <!-- Lets password managers store the new password under the right account -->
      <input id="rp-username" name="username" type="email" autocomplete="username" readonly tabindex="-1" aria-hidden="true" class="sr-only">

      <div class="field">
        <label for="rp-password" data-t="rp.new_password"><%= e(s['rp.new_password']) %></label>
        <div class="field-box">
          <input id="rp-password" name="password" type="password" autocomplete="new-password" autocapitalize="off" autocorrect="off" spellcheck="false" required aria-describedby="rp-rules">
          <button type="button" class="reveal-btn" data-toggle-password="rp-password" aria-pressed="false" aria-label="<%= e(s['rp.show_password']) %>" data-t-aria-label="rp.show_password"><%~ i.eye %><%~ i.eyeOff %></button>
        </div>
      </div>

      <div class="field">
        <label for="rp-confirm" data-t="rp.confirm_password"><%= e(s['rp.confirm_password']) %></label>
        <div class="field-box">
          <input id="rp-confirm" name="confirm" type="password" autocomplete="new-password" autocapitalize="off" autocorrect="off" spellcheck="false" required>
          <button type="button" class="reveal-btn" data-toggle-password="rp-confirm" aria-pressed="false" aria-label="<%= e(s['rp.show_password']) %>" data-t-aria-label="rp.show_password"><%~ i.eye %><%~ i.eyeOff %></button>
        </div>
      </div>

      <div class="rules" id="rp-rules">
        <p class="rules-title" data-t="rp.rules_title"><%= e(s['rp.rules_title']) %></p>
        <ul>
<% for (const rule of ['length', 'lower', 'upper', 'digit', 'symbol', 'match']) { %>
          <li class="hp-rule" data-rule="<%= rule %>" data-ok="false">
            <%~ i.ruleMark %>
            <span data-t="rp.rule_<%= rule %>"><%= e(s['rp.rule_' + rule]) %></span>
            <span class="sr-only" data-rule-state></span>
          </li>
<% } %>
        </ul>
      </div>

      <p id="rp-error" class="error" role="alert" hidden></p>

      <div class="submit">
        <button type="submit" id="rp-submit" class="btn btn-solid"><span id="rp-submit-label" data-t="rp.submit"><%= e(s['rp.submit']) %></span></button>
      </div>
    </form>

    <!-- Done -->
    <div data-view="success" class="block" hidden>
      <div class="notice flat" role="status">
        <%~ i.check %>
        <h2 class="notice-title" id="rp-success-title" tabindex="-1" data-t="rp.success_title"><%= e(s['rp.success_title']) %></h2>
        <p class="notice-text" data-t="rp.success_body"><%= e(s['rp.success_body']) %></p>
      </div>
      <div class="actions">
        <a class="btn btn-solid" href="<%= it.appScheme %>" data-t="rp.open_app"><%= e(s['rp.open_app']) %></a>
      </div>
      <p class="fine" data-t="rp.success_hint"><%= e(s['rp.success_hint']) %></p>
    </div>

    <noscript>
      <p class="text">JavaScript is required to reset your password.</p>
    </noscript>
  </div>
